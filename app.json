{
  "expo": {
    "name": "CDB Therapy",
    "slug": "daily-bread-app-mp9wlbr",
    "version": "6.0.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.daily-bread-app-mp9wlbr",
      "buildNumber": "73",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "CDB Therapy",
        "NSMicrophoneUsageDescription": "Allow CDB Therapy to access your microphone to record audio for therapy sessions and provide personalized feedback. Your audio data will not be stored and used only for the purpose of improving your mental health and wellness.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "toolkit.rork.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            },
            "rork.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "label": "CDB Therapy",
      "package": "app.rork.daily_bread_app_mp9wlbr",
      "versionCode": 8,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "statusBar": {
        "translucent": true,
        "backgroundColor": "#00000000"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow CDB Therapy to access your microphone to record audio for therapy sessions and provide personalized feedback. Your audio data will not be stored and used only for the purpose of improving your mental health and wellness."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_TOOLKIT_URL": "https://toolkit.rork.com",
      "EXPO_PUBLIC_YOUTUBE_CHANNEL_URL": "https://www.youtube.com/@cdbtherapy",
      "router": {
        "origin": "https://rork.com/"
      },
      "eas": {
        "projectId": "a2d06d38-d7ec-4cf8-a7e3-891d3cb0bf68"
      }
    },
    "owner": "the-web-gurus"
  }
}
